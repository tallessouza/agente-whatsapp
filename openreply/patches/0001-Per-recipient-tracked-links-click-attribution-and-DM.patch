+/**
+ * The @ of a user (by IGSID) who messaged or commented on the business
+ * account, via the Instagram Messaging profile API. Null when Meta does not
+ * return it, so callers keep their existing fallback.
+ */
+export async function getUserUsername(
+  accessToken: string,
+  recipientId: string
+): Promise<string | null> {
+  const url = new URL(`${instagramGraphBase()}/${recipientId}`);
+  url.searchParams.set("fields", "username");
+  try {
+    const response = await fetch(url.toString(), {
+      method: "GET",
+      headers: { Authorization: `Bearer ${accessToken}` },
+    });
+    if (!response.ok) return null;
+    const data = await response.json();
+    return typeof data?.username === "string" && data.username ? data.username : null;
+  } catch {
+    return null;
+  }
+}
